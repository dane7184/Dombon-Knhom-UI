# Data source: "mock" (default when unset) serves local mock data and never
# calls the backend; "api" uses the real Dombon Khnom API below.
# NEXT_PUBLIC_* values are inlined at build time — restart `npm run dev` after changing.
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=https://api.dombonkhnom.com/api/v1/

# Optional mock tuning (mock mode only):
#   NEXT_PUBLIC_MOCK_DELAY_MS — simulated latency per call (default 200, 0 disables)
#   NEXT_PUBLIC_MOCK_FAIL     — comma-separated scopes that fail deterministically,
#                               e.g. "organizer.kpi,activity.gallery" or "*" for all
# NEXT_PUBLIC_MOCK_DELAY_MS=200
# NEXT_PUBLIC_MOCK_FAIL=
# Mock logins = README test accounts (dane001-004@gmail.com, password Koko@1234)

AUTH_SECRET=
AUTH_URL=http://localhost:3000

AUTH_GOOGLE_SECRET=
AUTH_CLIENT_ID=
